node_modules/

# Local git worktrees for isolated SDD implementation work — per-machine
# scratch, never a project artifact.
.worktrees/

# Subagent-driven-development scratch — ledgers, briefs, review packages.
# Per-plan working state, not a project artifact.
.superpowers/sdd/

# Brainstorming visual-companion scratch — mockup HTML served to a local
# browser tab during a design discussion. Per-session, not a project artifact.
.superpowers/brainstorm/

# Claude's per-machine state — local settings, caches, session scratch — is
# noise in a diff and differs per developer. Its SKILLS are the opposite:
# shared tooling that should arrive with a clone, the same as anything in
# scripts/. Git cannot re-include a path under an excluded directory, hence
# the `.claude/*` form rather than `.claude/`.
.claude/*
!.claude/skills/
# Agents and commands are the same kind of thing as skills — the cavecrew
# subagents and the /caveman* commands are half of what the caveman family
# does, and a clone that got the skills but not these would silently lose
# them. Same reasoning, same re-include.
!.claude/agents/
!.claude/commands/
# Hook SOURCE, same reasoning again. These four files are the only reason
# `/caveman-stats` can produce a number at all — the skill is a stub whose
# output the hook injects. They are not live from here: `scripts/ensure-
# skills.sh` copies them to `~/.claude/hooks/` (user scope) and registers ONE
# UserPromptSubmit entry. Nothing under `.claude/settings.json` is committed,
# and that exclusion is deliberate — see skills.md.
!.claude/hooks/

# build output — never commit a copy of the app inside the app
the-hybrid-engine-netlify/
*.zip

# Android signing key — never commit the private keystore
native/android/*.keystore
native/**/target/
native/android/keystore.b64

# generated design-kit cards (regenerate: python3 design/_split_kit.py)
design/cards/
design/cards-index.html

# Vite/React build output
dist/
apps/web/dist-*/
.vite/
*.tsbuildinfo

# tsc must never emit beside a source. If these reappear, a build script
# has --noEmit disabled again.
apps/*/src/**/*.js
apps/*/src/**/*.js.map
apps/*/vite.config.js

# Screenshot output from checks/screens.mjs — regenerated, never committed.
.screens/

# Screenshot output from checks/artifact-smoke.mjs — same deal.
.artifact-screens/

# Python bytecode from the vendored skill scripts in .claude/skills/.
# The scripts are stdlib-only and run in place, so CPython writes __pycache__
# next to them the first time a skill invokes one. Artefacts, never sources.
__pycache__/
*.pyc

# Expo export output. `.expo-export` is the android bundle the release path
# builds; `.expo-parity` is the web export of the parity harness that
# checks/parity-harness.mjs serves. Both are regenerated, never committed.
apps/mobile/.expo-export/
apps/mobile/.expo-parity/

# checks/parity-visual.mjs's failure output. It writes `<shot>.actual.png` and
# `<shot>.diff.png` beside the baseline when a shot differs, and deletes both
# again the moment that shot passes — so they exist only while the gate is red.
# The BASELINES themselves are committed and are the specification; these two
# are the evidence for one run of one machine, and committing them would leave
# a stale picture of a failure that has since been fixed.
checks/fixtures/prototype/shots/*.actual.png
checks/fixtures/prototype/shots/*.diff.png

# graphify knowledge-graph output — derived, rebuildable, never committed
graphify-out/

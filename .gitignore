node_modules/

# Subagent-driven-development scratch — ledgers, briefs, review packages.
# Per-plan working state, not a project artifact.
.superpowers/sdd/

# Claude's per-machine state — local settings, caches, session scratch — is
# noise in a diff and differs per developer. Its SKILLS are the opposite:
# shared tooling that should arrive with a clone, the same as anything in
# scripts/. Git cannot re-include a path under an excluded directory, hence
# the `.claude/*` form rather than `.claude/`.
.claude/*
!.claude/skills/

# build output — never commit a copy of the app inside the app
the-hybrid-engine-netlify/
*.zip

# Android signing key — never commit the private keystore
native/android/*.keystore
native/**/target/
native/android/keystore.b64

# generated design-kit cards (regenerate: python3 design/_split_kit.py)
design/cards/
design/cards-index.html

# Vite/React build output
dist/
.vite/
*.tsbuildinfo

# tsc must never emit beside a source. If these reappear, a build script
# has --noEmit disabled again.
apps/*/src/**/*.js
apps/*/src/**/*.js.map
apps/*/vite.config.js

# Screenshot output from checks/screens.mjs — regenerated, never committed.
.screens/

# Metro bundle output from `pnpm --filter @hybrid/mobile bundle` — a build check,
# not an artifact.
apps/mobile/.expo-export/

# Expo CNG: the native project is GENERATED by `expo prebuild` and by EAS on
# every build. Committing it means hand-maintaining native code that app.json
# and the config plugins already describe, and the two drift silently.
apps/mobile/android/
apps/mobile/ios/

# Expo local state (device pairing, cached prebuild fingerprints).
apps/mobile/.expo/

# EAS local signing credentials, written by the workflow at build time from
# the ANDROID_KEYSTORE_B64 secret. Never committed.
apps/mobile/credentials.json
apps/mobile/*.keystore

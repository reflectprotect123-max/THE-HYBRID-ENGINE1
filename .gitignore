node_modules/
.claude/

# build output — never commit a copy of the app inside the app
the-hybrid-engine-netlify/
*.zip

# Android signing key — never commit the private keystore
native/android/*.keystore
native/**/target/
native/android/keystore.b64

# generated design-kit cards (regenerate: python3 design/_split_kit.py)
design/cards/
design/cards-index.html

# Vite/React build output
dist/
.vite/
*.tsbuildinfo

# tsc must never emit beside a source. If these reappear, a build script
# has --noEmit disabled again.
apps/*/src/**/*.js
apps/*/src/**/*.js.map
apps/*/vite.config.js

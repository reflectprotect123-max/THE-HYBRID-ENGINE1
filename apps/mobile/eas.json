{
  "cli": {
    "version": ">= 5.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "credentialsSource": "local",
      "channel": "preview"
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      },
      "credentialsSource": "local",
      "channel": "production"
    },
    "conditioning-preview": {
      "extends": "preview",
      "channel": "conditioning-preview",
      "env": {
        "EXPO_PUBLIC_HYBRID_PRODUCT": "conditioning"
      }
    },
    "conditioning-production": {
      "extends": "production",
      "channel": "conditioning-production",
      "env": {
        "EXPO_PUBLIC_HYBRID_PRODUCT": "conditioning"
      }
    }
  },
  "submit": {
    "production": {}
  }
}

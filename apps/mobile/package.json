{
  "name": "@hybrid/mobile",
  "version": "2.14.0",
  "private": true,
  "main": "index.js",
  "//": "Expo SDK 54 \u2014 RN 0.81 on React 19, so the whole monorepo stays on one React major. SDK 52 predates React 19 and would have forced a second React version into the workspace.",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "prebuild": "expo prebuild --platform android --clean",
    "build:apk": "eas build --platform android --profile preview",
    "build:aab": "eas build --platform android --profile production",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json --noEmit",
    "test": "jest",
    "bundle": "expo export --platform android --output-dir .expo-export",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@hybrid/config": "workspace:*",
    "@hybrid/coordinator-adapter": "workspace:*",
    "@hybrid/design": "workspace:*",
    "@hybrid/engine": "workspace:*",
    "@hybrid/guided-flow": "workspace:*",
    "@hybrid/nutrition-adapter": "workspace:*",
    "@hybrid/nutrition-core": "workspace:*",
    "@hybrid/nutrition-engine": "workspace:*",
    "@hybrid/product-scope": "workspace:*",
    "@hybrid/shared-core": "workspace:*",
    "@hybrid/whole-athlete-state": "workspace:*",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/native": "^7.1.6",
    "@react-navigation/native-stack": "^7.3.10",
    "@supabase/supabase-js": "^2.110.8",
    "expo": "~54.0.36",
    "expo-camera": "~17.0.10",
    "expo-font": "~14.0.12",
    "expo-keep-awake": "~15.0.8",
    "expo-location": "~19.0.8",
    "expo-mlkit-ocr": "0.2.7",
    "expo-notifications": "~0.32.12",
    "expo-status-bar": "~3.0.8",
    "expo-task-manager": "~14.0.9",
    "expo-updates": "~29.0.19",
    "nativewind": "^4.2.1",
    "react": "19.1.0",
    "react-native": "0.81.4",
    "react-native-ble-plx": "^3.5.0",
    "react-native-css-interop": "^0.2.6",
    "react-native-maps": "1.20.1",
    "react-native-mmkv": "^3.3.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-worklets": "0.5.1",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.0",
    "babel-preset-expo": "~54.0.12",
    "eas-cli": "^21.3.0",
    "jest": "~29.7.0",
    "jest-expo": "~54.0.17",
    "react-test-renderer": "19.1.0",
    "typescript": "^5.9.3"
  }
}

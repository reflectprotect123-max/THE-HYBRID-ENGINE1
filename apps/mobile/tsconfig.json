{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM"],
    "jsx": "react-jsx",
    "jsxImportSource": "nativewind",
    "moduleResolution": "bundler",
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "types": ["react", "nativewind/types", "jest"],
    "allowJs": true
  },
  "//include": "test/ is in here deliberately: a test that does not compile is a test that silently stops running, and `tsc` is the only thing that would say so before someone notices the count dropped.",
  "include": ["src/**/*.ts", "src/**/*.tsx", "parity/**/*.ts", "parity/**/*.tsx", "test/**/*.ts", "test/**/*.tsx", "index.js", "nativewind-env.d.ts"]
}

{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM"],
    "jsx": "react-jsx",
    "jsxImportSource": "nativewind",
    "moduleResolution": "bundler",
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "types": ["react", "nativewind/types"],
    "allowJs": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "index.js"]
}

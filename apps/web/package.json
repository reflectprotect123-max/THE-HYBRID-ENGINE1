{
  "name": "@hybrid/web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "build:strength": "tsc -p tsconfig.json --noEmit && VITE_HYBRID_PRODUCT=strength vite build --outDir dist-strength",
    "build:conditioning": "tsc -p tsconfig.json --noEmit && VITE_HYBRID_PRODUCT=conditioning vite build --outDir dist-conditioning",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hybrid/auto-coach": "workspace:*",
    "@hybrid/config": "workspace:*",
    "@hybrid/coordinator-adapter": "workspace:*",
    "@hybrid/design": "workspace:*",
    "@hybrid/engine": "workspace:*",
    "@hybrid/guided-flow": "workspace:*",
    "@hybrid/nutrition-adapter": "workspace:*",
    "@hybrid/nutrition-core": "workspace:*",
    "@hybrid/nutrition-engine": "workspace:*",
    "@hybrid/product-scope": "workspace:*",
    "@hybrid/shared-core": "workspace:*",
    "@hybrid/whole-athlete-state": "workspace:*",
    "@supabase/supabase-js": "^2.110.8",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.2",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.3",
    "vite": "^7.1.5",
    "vite-plugin-pwa": "^1.0.3",
    "vitest": "^3.2.4"
  }
}
